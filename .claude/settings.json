{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect_raw.py\"",
            "timeout": 10,
            "statusMessage": "Controle: data/raw/ blijft onaangeroerd"
          }
        ]
      }
    ]
  }
}
